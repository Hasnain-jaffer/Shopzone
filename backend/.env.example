# Copy this file to .env and fill in real values. Never commit .env.

PORT=5001

# MongoDB connection string (local or Atlas). Generate a fresh Atlas user/
# password if this project previously had one hardcoded anywhere.
CONNECTION_STRING=mongodb://localhost:27017/shopzone

# Long, random, high-entropy secrets — generate with: openssl rand -hex 32
SESSION_SECRET=
TOKEN_SECRET=

# Frontend origin allowed to call this API with credentials (cookies)
ALLOWED_ORIGIN=http://localhost:3001
